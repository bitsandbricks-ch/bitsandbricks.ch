{
  "name": "bitsandbricks.ch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node tools/check-content.mjs --quiet && astro build && pagefind --site dist && node tools/check.mjs",
    "check:content": "node tools/check-content.mjs",
    "new": "node tools/new.mjs",
    "test": "node --test \"tests/*.test.ts\" \"tests/*.test.mjs\"",
    "test:e2e": "playwright test",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.6",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "pagefind": "1.6.0",
    "yaml": "2.9.1"
  }
}
