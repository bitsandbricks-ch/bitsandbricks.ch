---
import Site from "../../layouts/Site.astro";
import Graph from "../../components/Graph.astro";
import { noteGraph, buildGraph, tagIndex, branchPoint, folderInfo, url, short } from "../../lib/content";

const g = await noteGraph();
const graph = await buildGraph({ w: 760, h: 420 });
const tags = await tagIndex();
// Start the overview where the tree branches (skips kb/ -> cisco/ -> campus/ when that is all there is)
const top = branchPoint(g.notes);
const lead = top.id.slice(3);
const recent = [...g.notes].filter((n) => n.data.verified).sort((a, b) => (a.data.verified! < b.data.verified! ? 1 : -1)).slice(0, 5);
---
<Site title="Knowledge base" description="Notes on routing, switching, automation and the homelab, linked to each other." path="/kb/">
<main id="main" class="view"><div class="wrap">
  <div class="vhead">
    <p class="prompt"><b>$</b> <i>show kb summary</i></p>
    <h1>Knowledge base</h1>
    <p class="lede">{g.notes.length} notes on routing, switching and the homelab, in folders as deep as they need to be. Every folder has its own page, notes show what links back to them, and search is at the top (or press <kbd>/</kbd>).</p>
  </div>
  {lead && <nav class="crumb" aria-label="Path"><a href="/kb/">kb</a>{lead.split("/").map((p, i, a) => <><i>&gt;</i><a href={url("kb/" + a.slice(0, i + 1).join("/"))}>{p}</a></>)}</nav>}
  <div class="cats">
    {top.dirs.map((d) => { const f = folderInfo(g.notes, d); return <a class="cat" href={url(d)}><b>{short(d)}/</b><span>{f.total} {f.total === 1 ? "note" : "notes"}{f.dirs.length ? " · " + f.dirs.map(short).join(", ") : ""}</span></a>; })}
    {top.notes.map((n) => <a class="cat" href={url(n.id)}><b>{n.data.title}</b><span>note</span></a>)}
  </div>
  <div class="panel">
    <h4>graph · all notes</h4>
    <div class="graphbox"><Graph nodes={graph.nodes} edges={graph.edges} w={760} h={420} label="Graph of all notes, grouped by folder" labels="dirs" /></div>
    <a class="lk" href="/kb/graph/">open the full graph -&gt;</a>
  </div>
  <div class="panel">
    <h4>tags</h4>
    <a class="lk" href="/tags/">all tags -&gt;</a>
    <span class="tags">{[...tags.entries()].map(([t, v]) => <a class="tag" href={`/tags/${t}/`}>#{t} <span class="count">{v.docs.length + v.posts.length}</span></a>)}</span>
  </div>
  {recent.length > 0 && <div class="panel"><h4>recently verified</h4><div class="notelist">{recent.map((n) => <a href={url(n.id)}><b>{n.data.title}</b><span>{n.id.split("/").slice(1, -1).join("/")} · verified {n.data.verified}</span></a>)}</div></div>}
</div></main>
</Site>
