---
import Site from "../../layouts/Site.astro";
import { tagIndex, url } from "../../lib/content";
export async function getStaticPaths() {
  const tags = await tagIndex();
  return [...tags.entries()].map(([tag, v]) => ({ params: { tag }, props: { tag, v } }));
}
const { tag, v } = Astro.props as any;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Site title={`#${tag}`} description={`Notes, lessons and posts tagged ${tag}.`} path={`/tags/${tag}/`}>
<main id="main" class="view"><div class="wrap">
  <div class="vhead">
    <p class="prompt"><b>$</b> <i>show tag {tag}</i></p>
    <h1>#{tag}</h1>
    <p class="lede">{v.docs.length} notes and lessons, {v.posts.length} posts.</p>
  </div>
  {v.docs.length > 0 && <div class="notelist">{v.docs.map((d: any) => <a href={url(d.id)}><b>{d.data.title}</b><span>{d.id.split("/").slice(0, -1).join("/")}</span></a>)}</div>}
  {v.posts.length > 0 && <div class="notelist">{v.posts.map((p: any) => <a href={`/blog/${p.id}/`}><b>{p.data.title}</b><span>blog · {fmt(p.data.date)}</span></a>)}</div>}
</div></main>
</Site>
