---
// Same colour-scheme logic as the rest of the site (/assets/theme.js, key bb_theme).
// Starlight's CSS needs data-theme set at all times, so the system choice is written out too.
---
<script is:inline>
  window.StarlightThemeProvider = (() => {
    let saved = null;
    try { saved = localStorage.getItem("bb_theme"); } catch (e) {}
    document.documentElement.dataset.theme = saved === "light" || saved === "dark" ? saved : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    return { updatePickers() {} };
  })();
</script>
<script is:inline src="/assets/theme.js"></script>
