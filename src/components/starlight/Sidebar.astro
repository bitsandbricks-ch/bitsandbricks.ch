---
// On phones the sidebar is the menu: the site links sit above the kb / courses tree.
import Default from "@astrojs/starlight/components/Sidebar.astro";
import { NAV, GITHUB, LINKEDIN, isCurrent } from "../../lib/site";
const path = Astro.url.pathname;
---
<nav class="side-nav" aria-label="Site">
  {NAV.map(([href, label]) => <a href={href} aria-current={isCurrent(href, path) ? "page" : undefined}>{label}</a>)}
  <a href={GITHUB}>github</a>
  <a href={LINKEDIN}>linkedin</a>
</nav>
<Default><slot /></Default>
