---
// Title block for kb notes, course pages and lessons: breadcrumb, title, tags, save button,
// "verified" stamp for notes, lesson number and the course card for course pages.
import SaveButton from "../SaveButton.astro";
import Tags from "../Tags.astro";
import CourseCard from "../CourseCard.astro";
import { courses, url, allDocs } from "../../lib/content";

const route = Astro.locals.starlightRoute;
const id = route.id ?? "";
const data = route.entry.data as any;
const title = data.title as string;
const parts = id.split("/");
const real = (await allDocs()).some((d) => d.id === id);
const isKb = real && id.startsWith("kb/");
const isCourses = real && id.startsWith("courses/");
const all = isCourses ? await courses() : [];
const course = isCourses ? all.find((c) => c.slug === parts[1]) : undefined;
const isCourseIndex = !!data.course;
const lessonIdx = course && !isCourseIndex ? course.lessons.findIndex((l) => l.id === id) : -1;
const lesson = lessonIdx >= 0 ? course!.lessons[lessonIdx] : undefined;
const old = typeof data.verified === "string" && data.verified < new Date(Date.now() - 1000 * 3600 * 24 * 182).toISOString().slice(0, 7);

let crumb: [string, string?][] = [];
if (isKb) crumb = [["kb", "/kb/"], ...parts.slice(1, -1).map((p): [string] => [p]), [parts[parts.length - 1]]];
if (course) crumb = [["courses", "/courses/"], [course.title, isCourseIndex ? undefined : course.href], ...(lesson ? [[lesson.section] as [string], [lesson.title] as [string]] : [])];
const kind = isKb ? "kb" : lesson ? "lesson" : course ? "course" : "page";
---
{crumb.length > 0 && (
  <nav class="crumb sl-crumb" aria-label="Breadcrumb">
    {crumb.map(([label, href], i) => <>{i > 0 && <i>&gt;</i>}{href ? <a href={href}>{label}</a> : <span>{label}</span>}</>)}
  </nav>
)}
{data.prompt && <p class="prompt sl-prompt"><b>$</b> <i>{data.prompt}</i></p>}
{lesson && <p class="lesson-no">lesson {lessonIdx + 1}/{course!.lessons.length} <span>· {lesson.section}</span></p>}
<h1 id="_top">{title}</h1>
{(isKb || isCourses) && (
  <div class="title-meta">
    {data.verified && <span class={"pill " + (old ? "cur" : "ok")}>verified {data.verified}{old ? " · check again" : ""}</span>}
    {isCourses && <span class="pill">access: {data.access}</span>}
    <Tags tags={data.tags ?? []} />
    <SaveButton url={url(id)} title={title} kind={kind} />
  </div>
)}
{data.sample && <p class="sample-note" style="margin-top:14px">Sample page written for the first version. Replace it with real content.</p>}
{isCourseIndex && course && (
  <div class="lc-wrap">
    <CourseCard course={course} link={false} />
    <div class="btns" style="margin-top:14px">
      <a class="btn btn-p" href={course.lessons[0]?.href} data-continue>start: {course.lessons[0]?.title}</a>
      <button class="btn btn-s" type="button" data-reset={course.lessons.map((l) => l.id).join(" ")}>reset progress</button>
    </div>
  </div>
)}
