---
// The folder tree beside kb notes and lessons, and inside the phone menu. In the kb only the
// folders on the way to the current page start open (course sections are always open), so a big kb does not unfold all at once. A folder's name
// links to its overview page; the +/- in front of it opens and closes it.
import type { TreeItem } from "../../lib/content";
import { url } from "../../lib/content";
interface Props { items: TreeItem[]; current: string; links?: boolean; openAll?: boolean }
const { items, current, links = true, openAll = false } = Astro.props;
const onPath = (id: string) => current === id || current.startsWith(id + "/");
---
<ul>
  {items.map((i) => i.kind === "dir" ? (
    <li><details open={openAll || onPath(i.id) || undefined}><summary>{links ? <a class="dirlink" href={url(i.id)} aria-current={i.id === current ? "page" : undefined}>{i.label}</a> : i.label}</summary><Astro.self items={i.items} current={current} links={links} openAll={openAll} /></details></li>
  ) : (
    <li><a href={i.href} aria-current={i.id === current ? "page" : undefined}>{i.label}</a></li>
  ))}
</ul>
